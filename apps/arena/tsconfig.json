{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "verbatimModuleSyntax": true
  },
  "include": ["src", "test", "*.ts"]
}
